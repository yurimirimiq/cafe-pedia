# 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 절대 커밋하지 않기)
DJANGO_SECRET_KEY=여기에-랜덤-문자열
DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# 4단계(카페 검색)에서 사용
KAKAO_REST_API_KEY=

# 카카오 로그인 후 돌아올 프론트 주소 (기본값: http://localhost:5173/auth/kakao). 카카오 콘솔 Redirect URI 와 같아야 한다
# KAKAO_REDIRECT_URI=
# 카카오 콘솔에서 Client Secret 을 켰을 때만
# KAKAO_CLIENT_SECRET=
